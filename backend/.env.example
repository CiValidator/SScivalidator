# ==============================================================================
# Sign Setu Gateway Environment Configuration (.env)
# ==============================================================================

# Database connection: SQLite for local tests; PostgreSQL for production
DATABASE_URL=sqlite:///gateway.db

# Set to 1 in production so the service halts if DATABASE_URL falls back to ephemeral SQLite
REQUIRE_PERSISTENT_DB=0

# Local directory where downloadable model bundles are hosted (/v1/models)
MODEL_DIR=models

# Comma-separated SHA-256 hashes of authorized 1-time enrollment codes (generated via tools/make_codes.py)
# ENROLL_HASHES=a1b2c3d4...,e5f6g7h8...
ENROLL_HASHES=

# Upstream LLM provider endpoint for the gateway's AI assistant proxy (/v1/assist)
# Examples:
# OpenRouter: https://openrouter.ai/api/v1/chat/completions
# Groq:       https://api.groq.com/openai/v1/chat/completions
# AgentRouter: https://agentrouter.org/v1/responses
ASSIST_URL=https://openrouter.ai/api/v1/chat/completions

# API key for the upstream LLM provider
ASSIST_KEY=your_upstream_api_key_here

# Upstream LLM model identifier
ASSIST_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenID Connect (OIDC) identity provider realm URL (e.g., Keycloak, Authentik, Okta)
# Required only if securing the admin/reviewer endpoints (/v1/admin/*). Leave empty to disable admin routes.
# Example: https://auth.example.gov.in/realms/police-dept
OIDC_ISSUER=

# Audience claim expected inside OIDC JWT tokens for reviewer/admin access
OIDC_AUDIENCE=signsetu-portal

# Expected realm role name for administrative access (device revocation and audit logs)
ADMIN_ROLE=gateway-admin

# Enrolled mobile device token expiration in days (0 = token never expires)
TOKEN_TTL_DAYS=0

# Number of reverse proxy hops (e.g., Cloudflare, Nginx) before client IP in X-Forwarded-For
TRUSTED_PROXY_HOPS=0
