<?xml version="1.0" encoding="utf-8"?>
<!--
    Nearby flavor only. Nearby Connections scans and advertises over Bluetooth and Wi-Fi, so this build adds
    these permissions; the standard build has none of them, and its build gate refuses them. No INTERNET, no
    RECORD_AUDIO and no background location here either: the gate checks this flavor for those.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" android:maxSdkVersion="31" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" android:maxSdkVersion="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <application>
        <!-- Exposure notifications are part of the library, not of this app. -->
        <service
            android:name="com.google.android.gms.nearby.exposurenotification.WakeUpService"
            tools:node="remove" />
    </application>
</manifest>
